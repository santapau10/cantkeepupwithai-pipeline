generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Neon Postgres — a separate project from the main cantkeepupwithai app's
  // database. This one is the pipeline's own working state (RawPost, Source,
  // ClusterCandidate, StoryDraft...); the two only ever talk via the sync API
  // call in src/sync/export.ts, never a shared database.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id        String    @id @default(uuid())
  type      String    // "hn" | "reddit" | "github" | "rss"
  kind      String    @default("community") // "community" | "news" — see README § Trends vs digest sourcing
  name      String    @unique // e.g. "r/LocalLLaMA", "Simon Willison's Blog"
  config    String    // JSON blob: subreddit name, feed url, search query, etc.
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  posts     RawPost[]

  @@map("sources")
}

model RawPost {
  id          String              @id @default(uuid())
  source      Source              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId    String
  externalId  String              // the source's own id for this post (dedup key)
  title       String
  // English display copy of `title`, filled in lazily by export.ts only for
  // posts that actually get selected as a trend reference — never touched
  // by `tag`, which always matches keywords/embeddings against the
  // original `title` regardless of language. Null until first translated;
  // once set, holds the original text unchanged if it was already English
  // (so it's cached either way and never re-sent to the model twice).
  titleTranslated String?
  url         String
  // Real excerpt when the source API gives one for free (RSS description,
  // YouTube video description, GitHub repo description) — null for HN/
  // Reddit/X, which don't have a natural equivalent. See export.ts, which
  // forwards this straight through to the web's already-existing
  // TrendReference.snippet column.
  snippet     String?
  // English display copy of `snippet` — same lazy/cached/display-only
  // treatment as titleTranslated above, filled in together in the same
  // translate call. Never used for matching (snippet never is, to begin
  // with).
  snippetTranslated String?
  author      String?
  score       Int                 @default(0)
  commentCount Int                @default(0)
  postedAt    DateTime
  fetchedAt   DateTime            @default(now())
  mentions    PostTrendMention[]

  @@unique([sourceId, externalId])
  @@map("raw_posts")
}

model TrendDefinition {
  id        String             @id @default(uuid())
  // Mirrors taxonomy.yaml — upserted from the YAML file on every run, so
  // the YAML (reviewed via PR) is the source of truth, not this table.
  name      String             @unique
  tag       String
  aliases   String             // JSON array of match strings
  mentions  PostTrendMention[]

  @@map("trend_definitions")
}

model PostTrendMention {
  id             String          @id @default(uuid())
  post           RawPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String
  trend          TrendDefinition @relation(fields: [trendId], references: [id], onDelete: Cascade)
  trendId        String
  matchedKeyword String

  @@unique([postId, trendId])
  @@map("post_trend_mentions")
}

model ClusterCandidate {
  id                String   @id @default(uuid())
  samplePostIds     String   // JSON array
  suggestedName     String
  suggestedTag      String   @default("") // technique | protocol | workflow | infra | tool | meta
  suggestedAliases  String   @default("[]") // JSON array — same shape as taxonomy.yaml's aliases,
  // proposed by the same labeling call as suggestedName/suggestedTag/rationale. Only ever read by
  // scripts/applyCandidate.ts once a human approves — same "propose, never auto-edit the taxonomy
  // by itself" boundary as the rest of discover, just with the taxonomy.yaml write now automated
  // once a human has clicked approve, instead of also being hand-typed.
  rationale         String   @default("") // why the model thinks this is a distinct trend
  clusterSize       Int      @default(0)  // total untagged posts in the cluster, not just the sample
  status            String   @default("pending") // pending | approved | rejected
  // Set by scripts/applyCandidate.ts when an approved candidate looks like a
  // duplicate of an existing trend (by alias overlap or name similarity —
  // see taxonomy/similarity.ts) and it refused to write taxonomy.yaml.
  // Null means either not yet applied, or applied clean. Surfaced in
  // /admin so it doesn't just silently do nothing; cleared once someone
  // force-applies it or renames it and it no longer collides.
  applyBlockedReason String?
  createdAt         DateTime @default(now())

  @@map("cluster_candidates")
}

model StoryDraft {
  id            String   @id @default(uuid())
  digestDate    DateTime
  headline      String
  summary       String
  whyItMatters  String
  sourcePostIds String   // JSON array
  status        String   @default("draft") // draft | approved | published
  createdAt     DateTime @default(now())

  @@map("story_drafts")
}

model PipelineRun {
  id              String   @id @default(uuid())
  stage           String   // "ingest" | "tag" | "aggregate" | "discover" | "synthesize"
  ranAt           DateTime @default(now())
  postsProcessed  Int      @default(0)
  errors          Int      @default(0)
  detail          String?  // JSON blob, per-stage free-form detail

  @@map("pipeline_runs")
}
