# Postgres connection string — a free Neon project (https://neon.tech) of its
# own, separate from the main cantkeepupwithai app's database. Needed for any
# scheduled (GitHub Actions) run to persist state between runs; SQLite works
# fine for local one-off `npm run dev <stage>` testing but resets on CI.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Required for `discover` (weekly new-trend labeling) only — no longer
# needed on the daily path since the Digest/synthesize stage was removed.
ANTHROPIC_API_KEY=""

# Required for the Reddit connector. Create a "script" app at
# https://www.reddit.com/prefs/apps to get these.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="cantkeepupwithai-pipeline/0.1 (by /u/your-username)"

# Optional: raises the GitHub Search API rate limit from 60/hr (unauthenticated)
# to 5,000/hr. A classic PAT with no scopes is enough for public search.
GITHUB_TOKEN=""

# Required for the X connector. Bearer (App-only) token from a Pay-Per-Use
# developer app at https://developer.x.com. Read-only, tracks a fixed list
# of accounts (src/config/sources.yaml).
X_BEARER_TOKEN=""

# Required for `discover` (weekly, embeddings) and `tag`'s embedding
# fallback pass (daily — see README § Two-pass tagging). Anthropic has no
# first-party embeddings endpoint — Voyage AI is their recommended partner.
# Get a key at https://dash.voyageai.com/. Default model (voyage-4-lite)
# costs $0.02/1M tokens after the first 200M tokens/account, which are free
# — checked against docs.voyageai.com/docs/pricing. At this pipeline's
# volume that free tier lasts years.
VOYAGE_API_KEY=""

# Where the `export` stage syncs trends into the main cantkeepupwithai app —
# its POST /api/pipeline/sync endpoint. Local dev: http://localhost:4000.
# In production this needs the app's deployed URL. WEB_SYNC_API_KEY must match
# PIPELINE_API_KEY in that repo's backend/.env exactly. Leave either blank to
# skip syncing — export still writes data/export/sync-<date>.json locally.
WEB_SYNC_URL=""
WEB_SYNC_API_KEY=""

# Required for the admin API (src/admin/) — HTTP Basic Auth for the
# /admin/candidates review endpoints used by cantkeepupwithai.com/admin.
# Single user by design, not a full auth system. In production these are
# set as env vars on the admin API's own Vercel project — separate from
# the GitHub Actions secrets, which only apply to the CLI/batch workflows.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# The frontend origin allowed to call the admin API via CORS — e.g.
# https://cantkeepupwithai.com in production, http://localhost:5173 for
# local frontend dev. No wildcard: this API can mutate review state.
ADMIN_CORS_ORIGIN="http://localhost:5173"
